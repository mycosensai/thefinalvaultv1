{
  "name": "thefinalvaultv1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "ts-node-esm server/server.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "tsc && vite build",
    "build": "npm run build:server && npm run build:ui",
    "deploy:pages": "wrangler pages publish dist --project-name=thefinalvaultv1 --branch=main",
    "deploy:worker": "wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.19",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "eslint": "^10.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "wrangler": "^4.96.0"
  }
}
